# Telegram
# Create a bot via @BotFather, paste the token here.
TELEGRAM_BOT_TOKEN=
# Single Telegram user ID allowed to interact with the bot.
# Get yours by DMing @userinfobot.
TELEGRAM_ALLOWED_CHAT_ID=

# Azure (filled after `azd up` or Bicep deploy)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=swedencentral

# Foundry project endpoint (filled after project creation)
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_AGENT_NAME=companion
# Whisper deployment name for voice-note transcription (optional).
# Set to the name of a Whisper model deployment in your Azure AI Foundry project.
# When unset, voice notes are forwarded to memex without in-process transcription.
AZURE_OPENAI_WHISPER_DEPLOYMENT=

# Storage (filled by Bicep output)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_BRIEFING_CONTAINER=briefing-context
AZURE_STORAGE_CAPTURE_QUEUE=capture-events

# Key Vault (filled by Bicep output)
AZURE_KEYVAULT_NAME=
AZURE_KEYVAULT_BOT_TOKEN_SECRET=telegram-bot-token
AZURE_KEYVAULT_ENCRYPTION_KEY_SECRET=briefing-encryption-key

# App Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Phase 2: Function App hostname (e.g. func-mindme-r4k2p.azurewebsites.net).
# When set, `scripts/dev/create_agent.py` registers the OpenAPI tool on the
# agent so it can call /api/tools/briefing_context and /api/tools/weather.
MINDME_FUNCTION_APP_HOSTNAME=
# Foundry Custom Keys connection containing x-functions-key (not the key itself).
# Tool registration fails closed if this connection is missing.
MINDME_TOOLS_CONNECTION_NAME=mindme-tools
MINDME_HOME_LOCATION=Riga

# Personal OS root (used by scripts/local/sync_os_to_blob.py).
# Default: %USERPROFILE%\OneDrive\.vscode\.me
# Set explicitly to the approved source. A blank value is rejected by the sync.
ME_OS_ROOT=

# memex capture engine — full webhook URL incl. the Function key as ?code=...
# mindMe forwards capture-intent messages (save:/note:/idea:/URL) and review
# button taps here. e.g. https://memex-func-xxxx.azurewebsites.net/api/dump/mindme?code=<key>
MEMEX_WEBHOOK_URL=

# memex /state endpoint — full URL incl. the Function key as ?code=... Returns the
# open-loops projection (open ideas + open tasks) for the mindMe vault, read from
# mindVault (never .me). Powers idea/task resurfacing in the briefing / weekly
# review. Unset → ideas/tasks reported as unavailable, never zero. e.g.
# https://memex-func-xxxx.azurewebsites.net/api/state?vault=mindMe&code=<key>
MEMEX_STATE_URL=

# dig (deep research, Mode B) — GitHub PAT with issues:write on the mindVault repo.
# `/dig <question>` opens a labelled 'dig' issue; a workflow assigns Copilot to run it.
# In production store this as a Key Vault secret and reference it from App Settings.
DIG_GITHUB_TOKEN=
DIG_REPO=samoletovs/mindVault

# Existing action/knowledge review infrastructure. Endpoints are Key Vault
# references in production; never copy their function keys into this file.
MINDME_ACTION_BRIEFING_ENABLED=false
MINDME_DAILY_EVOLVE_ENABLED=false
MINDME_BRIEFING_MODEL=gpt-4o-mini
MEMEX_ACTION_URL=
