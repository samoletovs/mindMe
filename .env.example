# Telegram
# Create a bot via @BotFather, paste the token here.
TELEGRAM_BOT_TOKEN=
# Single Telegram user ID allowed to interact with the bot.
# Get yours by DMing @userinfobot.
TELEGRAM_ALLOWED_CHAT_ID=

# Azure (filled after `azd up` or Bicep deploy)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=swedencentral

# Foundry project endpoint (filled after project creation)
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_AGENT_NAME=companion

# Storage (filled by Bicep output)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_BRIEFING_CONTAINER=briefing-context
AZURE_STORAGE_CAPTURE_QUEUE=capture-events

# Key Vault (filled by Bicep output)
AZURE_KEYVAULT_NAME=
AZURE_KEYVAULT_BOT_TOKEN_SECRET=telegram-bot-token
AZURE_KEYVAULT_ENCRYPTION_KEY_SECRET=briefing-encryption-key

# App Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=
